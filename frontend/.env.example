# Nuxt 3 runtime config
# Copy to .env (gitignored) and fill in real values

# Internal Docker hostname for Drupal (server-side only)
# In Docker Compose: use the container name and internal port
DRUPAL_BASE_URL=http://drupal:80

# GitHub personal access token (optional, avoids rate limiting)
GITHUB_TOKEN=

# Photo site public URL (used for WP REST API calls)
PHOTO_SITE_URL=https://photo.madsnorgaard.net
